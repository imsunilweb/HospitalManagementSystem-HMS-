@model HospitalManagementSystem_HMS_.JWTDTOs.RegisterDto

@{
    ViewData["Title"] = "Register";
}



<div class="container align-items-center justify-content-center">
    <div class="row">
        <div class="col-4"></div>
        <div class="col-4 shadow-lg  blur-card rounded-3  p-5 m-0">
            <div class="col-4"></div>
            <h2 class="text-center fw-bolder text-uppercase">Register</h2>
            <div class="p-2">
                <form asp-action="Register" method="post">
                    <div class="form-group m-2">
                        <label asp-for="FullName"></label> <br />
                        <input asp-for="FullName" class="form-control" />
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>

                    <div class="form-group m-2">
                        <label asp-for="Email"></label> <br />
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="form-group m-2">
                        <label asp-for="Password"></label> <br />
                        <input asp-for="Password" type="password" class="form-control" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="form-group m-2">
                        <label asp-for="ConfirmPassword"></label><br />
                        <input asp-for="ConfirmPassword" type="password" class="form-control" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>

                    <div class="form-group m-2">
                        <label asp-for="BloodGroup" class="control-label"></label> <br />
                        <select asp-for="BloodGroup" class="form-control" asp-items="new SelectList(ViewBag.BloodGroups)">
                            <option value="">-- Select Blood Group --</option>
                        </select>
                        <span asp-validation-for="BloodGroup" class="text-danger"></span>
                    </div>

                    <div class="form-group m-2">
                        <label asp-for="DOB"></label> <br />
                        <input asp-for="DOB" type="date" class="form-control" />
                        <span asp-validation-for="DOB" class="text-danger"></span>
                    </div>

                    <div class="form-group m-2">
                        <label asp-for="Gender"></label> <br />
                        <select asp-for="Gender" class="form-control">
                            <option value="">Select Gender</option>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                        </select>
                        <span asp-validation-for="Gender" class="text-danger"></span>
                    </div>
                    <div class="form-group m-2">
                        <label asp-for="Role"></label> <br />
                        <select asp-for="Role" class="form-control" asp-items="@(new SelectList(new[] { "Admin", "Doctor", "Patient", "Staff" }))">
                            <option value="">-- Select Role --</option>
                        </select>
                        <span asp-validation-for="Role" class="text-danger"></span>
                    </div>

                    <div class="form-group m-2">
                        <label asp-for="Address"></label> <br />
                        <input asp-for="Address" class="form-control" />
                        <span asp-validation-for="Address" class="text-danger"></span>
                    </div>

                    <div class="form-group m-2">
                        <label asp-for="HealthScheme"></label> <br />
                        <select asp-for="HealthScheme" asp-items="Html.GetEnumSelectList<HospitalManagementSystem_HMS_.IdentityModels.HealthSchemeType>()" class="form-control">
                            <option value="">Select Health Scheme</option>
                        </select>
                        <span asp-validation-for="HealthScheme" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn register-btn btn-primary">Register</button>
                    <p class="text-center login-btn align-items-center">Already have an Account ? <a asp-action="Login">Login Here</a></p>
                </form>
            </div>
        </div>
        <div class="col-4"></div>
    </div>
 </div>



