<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HospitalManagementSystem_HMS_</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HospitalManagementSystem_HMS_.styles.css" asp-append-version="true" />
</head>

<!-- ✅ Flexbox applied here -->
<body class="d-flex flex-column min-vh-100">
    <header class="sticky-header">
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light   h-auto">
            <div class="container-fluid d-flex flex-column ">

                <!-- Logo and toggler left aligned, nav items right -->
                <div class="w-100 d-flex justify-content-between align-items-center">
                    <a class="navbar-brand logo " asp-area="" asp-controller="Home" asp-action="Index">
                        <img src="~/img/images-removebg-preview.png" alt="HospitalManagementSystem_HMS_" />
                    </a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                            aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="navbar-collapse collapse d-sm-inline-flex w-100 justify-content-end">
                        <ul class="navbar-nav head-btn">
                            <li class="nav-item home-btn">
                                <a class="nav-link text-light" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                            </li>
                            <li class="nav-item privacy-btn">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Account" asp-action="Login">Login</a>
                            </li>
                            <li class="nav-item home-btn">
                                <a class="nav-link text-light" asp-area="" asp-controller="Account" asp-action="Register">Register</a>
                            </li>
                        </ul>
                    </div>
                </div>
                <!-- 👇 Search + Toll-Free aligned to RIGHT -->
                <div class="mt-2 text-end search-btn d-inline-flex w-100 justify-content-end">
                    <div class=" mt-1 tollfree text-nowrap " style="margin-right:20px;">
                        <strong>Toll Free:</strong> 1800-123-4567
                    </div>
                    <div class="input-group city-search align-items-center" style="max-width: 420px; margin-right:110px;">
                        <input type="text" class="form-control " placeholder="Enter a city Name...." aria-label="Search">
                        <button class="btn " type="button">Search</button>
                    </div>
                </div>


            </div>
        </nav>
    </header>

    <!-- ✅ Main content takes full space -->
    <div class="container flex-grow-1">
        <main role="main" class="pb-3 m-5">
            @RenderBody()
        </main>
    </div>

    <!-- ✅ Footer always at bottom -->
    <footer class="my-footer footer text-black mt-auto">
        <div class="container">
            &copy; 2025 - HospitalManagementSystem_HMS_ -
            <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
